# SprintFlint VPS Agent Configuration
# Copy this file to .env and fill in your values

# Your SprintFlint API token (required)
# Get this from: https://sprintflint.com/settings/api
SPRINTFLINT_TOKEN=your_api_token_here

# Optional: Custom API URL (defaults to https://api.sprintflint.com)
# SPRINTFLINT_API_URL=https://api.sprintflint.com
