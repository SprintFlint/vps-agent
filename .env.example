# SprintFlint VPS Agent configuration overrides.
# Any of these may also be set as real environment variables.
# Precedence (highest first): env var > .env file > ~/.vps-agent/config.json > defaults.

# Base URL of the SprintFlint server.
#   prod: https://sprintflint.com
#   dev:  http://localhost:3000
VPS_AGENT_API_URL=https://sprintflint.com

# Runner auth token (returned by `vps-agent register`, sent as X-Runner-Token).
VPS_AGENT_TOKEN=

# Log level: error | warn | info | debug
VPS_AGENT_LOG_LEVEL=info

# Harness used to execute jobs: noop (more added in later waves, e.g. claude-code).
VPS_AGENT_HARNESS=noop

# Permission mode passed to the harness (interpretation is harness-specific).
VPS_AGENT_PERMISSION_MODE=default

# Override the config/state directory (defaults to ~/.vps-agent).
VPS_AGENT_CONFIG_DIR=
